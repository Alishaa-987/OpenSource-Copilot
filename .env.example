NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------

# Repository service database (PostgreSQL)
DATABASE_URL=postgresql://opensource_copilot:local-development-placeholder@localhost:5432/opensource_copilot

# Guidance service database (PostgreSQL)
GUIDANCE_DATABASE_URL=postgresql://opensource_guidance:local-development-placeholder@localhost:5433/opensource_guidance

# Redis is used only as a cache / ephemeral side-store.
REDIS_URL=redis://localhost:6379

# Kafka (plaintext for local development only)
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_CLIENT_ID=opensource-copilot
# Optional when SASL is enabled by the broker.
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=placeholder
# KAFKA_SASL_PASSWORD=placeholder

# Consumer group shared by all backend consumers. Keep it unique per deployed
# environment so different services do not steal partitions from each other.
KAFKA_CONSUMER_GROUP=opensource-copilot-local

# Consumer tuning (used by guidance-service and knowledge-service)
KAFKA_CONSUMER_FROM_BEGINNING=false
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_DELAY_MS=100

# -----------------------------------------------------------------------------
# GitHub OAuth App
# -----------------------------------------------------------------------------

# Create a GitHub OAuth App at https://github.com/settings/developers
# The Authorization callback URL must match GITHUB_REDIRECT_URI.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/github/auth/callback

# GitHub REST API client controls
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_API_TIMEOUT_MS=10000
GITHUB_API_MAX_RETRIES=3
GITHUB_API_RETRY_BASE_DELAY_MS=250
GITHUB_API_MAX_RETRY_DELAY_MS=5000

# Server-side Redis session settings
GITHUB_SESSION_COOKIE_NAME=osc_github_session
GITHUB_SESSION_TTL_SECONDS=604800
GITHUB_OAUTH_STATE_TTL_SECONDS=600

# URL of the Next.js frontend (used for OAuth return-to validation)
FRONTEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Knowledge Service (Phase 2 RAG)
# -----------------------------------------------------------------------------

# Internal service authentication. Must be identical in repository-service and
# knowledge-service. Generate at least 32 random characters.
KNOWLEDGE_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# URL of the Repository Service internal API (used by knowledge-service)
REPOSITORY_SERVICE_URL=http://localhost:3001/api

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opensource_repository_chunks
# Leave empty when Qdrant does not require authentication.
QDRANT_API_KEY=

# Embedding provider. Without EMBEDDING_BASE_URL + EMBEDDING_API_KEY the service
# starts but embedding/indexing/retrieval will fail.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-server-side-embedding-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REQUEST_TIMEOUT_MS=10000

# LLM provider. Without LLM_BASE_URL + LLM_API_KEY the service starts but the
# ask endpoint will fail.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-server-side-llm-key
LLM_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=30000

# Chunking / retrieval tuning
KNOWLEDGE_REQUEST_TIMEOUT_MS=10000
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_RETRIEVAL_LIMIT=5
KNOWLEDGE_MIN_RELEVANCE=0.35

# -----------------------------------------------------------------------------
# Runtime controls
# -----------------------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
