{
  "name": "@opensource-copilot/source",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "OpenSource Copilot backend monorepo (Nx + NestJS). The web frontend in apps/web is managed independently and is not part of this workspace.",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:logs": "docker-compose logs -f",
    "prisma:generate": "prisma generate --schema apps/repository-service/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/repository-service/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema apps/repository-service/prisma/schema.prisma",
    "prisma:guidance:generate": "prisma generate --schema apps/guidance-service/prisma/schema.prisma",
    "prisma:guidance:dev": "prisma migrate dev --schema apps/guidance-service/prisma/schema.prisma",
    "prisma:guidance:deploy": "prisma migrate deploy --schema apps/guidance-service/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.0",
    "prettier": "~3.6.2",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.19.3",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.25.76"
  }
}
