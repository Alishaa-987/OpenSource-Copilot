# Normalise line endings so a Windows checkout does not show every file as
# modified. Without this the repository reported 100+ changed files that
# differed only by CRLF vs LF.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets are never normalised or diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary

# Generated - collapse in diffs and exclude from language statistics.
package-lock.json linguist-generated=true -diff
