// Prisma schema for the repository-service.
//
// OWNERSHIP: repository-service owns and migrates these tables. Other services
// must not read or write them directly; use service APIs or domain events.
//
// SCOPE: OpenSource Copilot Phase 1 data model. This contains persistence
// foundations only; it does not implement GitHub API integration, AI, or RAG.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Validated at service startup by @osc/config.
  url      = env("DATABASE_URL")
}

model MigrationProbe {
  id        String   @id @default(uuid())
  note      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("migration_probe")
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  githubUserId       BigInt             @unique
  username           String             @unique
  displayName        String?
  avatarUrl          String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  repositoryAccesses RepositoryAccess[]

  @@map("users")
}

model GitHubInstallation {
  id                   String   @id @default(uuid()) @db.Uuid
  githubInstallationId BigInt   @unique
  accountType          String
  accountLogin         String
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@unique([accountType, accountLogin])
  @@map("github_installations")
}

model Repository {
  id                 String               @id @default(uuid()) @db.Uuid
  githubRepositoryId BigInt               @unique
  owner              String
  name               String
  fullName           String               @unique
  description        String?              @db.Text
  url                String
  stars              Int                  @default(0)
  forks              Int                  @default(0)
  language           String?
  topics             String[]             @default([])
  license            String?
  defaultBranch      String
  isFork             Boolean              @default(false)
  parentFullName     String?
  openIssuesCount    Int                  @default(0)
  lastSyncedAt       DateTime?            @db.Timestamptz(3)
  // Repository monitoring state: when the background job last checked this
  // repository's open issues on GitHub for ones we have not seen before.
  // Null means it has never been checked yet (e.g. just imported).
  lastIssueCheckAt   DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  accessEntries      RepositoryAccess[]
  documents          RepositoryDocument[]
  issues             Issue[]

  @@index([owner, name])
  @@index([lastSyncedAt])
  @@map("repositories")
}

model RepositoryAccess {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  repositoryId String     @db.Uuid
  accessLevel  String
  isActive     Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId, isActive])
  @@index([repositoryId, userId])
  @@map("repository_access")
}

model RepositoryDocument {
  id           String     @id @default(uuid()) @db.Uuid
  repositoryId String     @db.Uuid
  documentType String
  path         String
  content      String     @db.Text
  sha          String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([repositoryId, path])
  @@index([repositoryId, documentType])
  @@index([repositoryId, sha])
  @@map("repository_documents")
}

model Issue {
  id            String       @id @default(uuid()) @db.Uuid
  repositoryId  String       @db.Uuid
  githubIssueId BigInt       @unique
  number        Int
  title         String
  body          String?      @db.Text
  state         String
  author        String?
  commentsCount Int          @default(0)
  url           String
  isUpstream    Boolean      @default(false)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  closedAt      DateTime?    @db.Timestamptz(3)
  repository    Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  labels        IssueLabel[]

  @@unique([repositoryId, number])
  @@index([repositoryId, state])
  @@index([repositoryId, number])
  @@map("issues")
}

model IssueLabel {
  id      String @id @default(uuid()) @db.Uuid
  issueId String @db.Uuid
  name    String
  color   String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([issueId, name])
  @@index([issueId])
  @@map("issue_labels")
}

// In-app notifications for users about their monitored repositories (e.g. a
// newly detected GitHub issue). Deliberately kept as plain scalar references
// (no Prisma relations to User/Repository/Issue) so this feature does not
// require touching those existing models - dedup and lookups only ever need
// the ids below, not nested includes.
model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  repositoryId String   @db.Uuid
  issueId      String   @db.Uuid
  // Denormalised so a notification can be rendered without joining back to
  // the repository/issue rows (and still reads correctly if either changes).
  repositoryFullName String @default("")
  issueNumber        Int    @default(0)
  issueTitle         String @default("")
  // new_issue | new_comment | issue_closed | issue_reopened | issue_retitled
  type         String   @default("new_issue")
  message      String
  /// Internal link into the issue workspace.
  url          String
  /// Canonical github.com link for the issue this event belongs to.
  githubUrl    String   @default("")
  /// Deterministic identity of the underlying GitHub event - for example
  /// "issue:123456", "comment:987654", "state:123456:closed". Unique per
  /// user, so re-polling can never produce a second copy of the same event.
  /// Nullable only so rows written before this column existed stay valid;
  /// Postgres treats NULLs as distinct, so they never collide.
  dedupeKey    String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([repositoryId])
  @@map("notifications")
}

// Per-user progress on one issue. This is the only *new* source of truth the
// contributor profile needs: "viewed" is recorded automatically when the
// issue workspace is opened, and the user moves it to started/completed.
// Every other profile statistic is derived from tables that already exist
// (repository_access, repositories, issues), so nothing is duplicated here.
model IssueProgress {
  userId       String    @db.Uuid
  issueId      String    @db.Uuid
  repositoryId String    @db.Uuid
  /// viewed | started | completed
  status       String    @default("viewed")
  startedAt    DateTime? @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@id([userId, issueId])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@map("issue_progress")
}

// Append-only activity timeline. Kept separate from IssueProgress because it
// records *events* (what happened, when) rather than current state - that is
// what the contribution timeline, streak and milestone sections read.
// `dedupeKey` makes repeated signals for the same event idempotent, so an
// automatic "viewed" ping on every page load cannot inflate the timeline.
model ContributorActivity {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  /// repository_analyzed | issue_viewed | issue_started | issue_completed
  type         String
  repositoryId String?  @db.Uuid
  issueId      String?  @db.Uuid
  /// Small display payload (repository full name, issue number/title).
  metadata     Json?
  occurredAt   DateTime @default(now()) @db.Timestamptz(3)
  dedupeKey    String?

  @@unique([userId, dedupeKey])
  @@index([userId, occurredAt])
  @@index([userId, type])
  @@map("contributor_activity")
}
