{
  "name": "knowledge-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/knowledge-service/src",
  "projectType": "application",
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "webpack-cli build", "env": { "NODE_ENV": "production" }, "cwd": "apps/knowledge-service" }, "configurations": { "development": { "env": { "NODE_ENV": "development" } } } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p tsconfig.app.json --noEmit", "cwd": "apps/knowledge-service" } }
  }
}
