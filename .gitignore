# ─────────────────────────────────────────────────────────────
# Root .gitignore for the OpenSource Copilot backend monorepo.
# NOTE: apps/web (frontend) keeps its own .gitignore.
# ─────────────────────────────────────────────────────────────

# dependencies
node_modules/
.pnp
.pnp.*

# Nx
.nx/cache
.nx/workspace-data

# build output
dist/
tmp/
out-tsc/
build/
*.tsbuildinfo

# Environment files — NEVER commit real secrets.
# .env.example IS committed (placeholders only).
.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# testing / coverage
coverage/
.jest-cache/

# Prisma: the generated client lives under node_modules; migrations ARE committed.

# local docker bind-mount data (compose uses named volumes by default)
.docker-data/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.claude/
